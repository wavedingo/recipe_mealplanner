DATABASE_URL=postgresql://user:password@db:5432/mealplanner
# next-auth v5 uses AUTH_URL (only needed in some deployments, optional locally)
# AUTH_URL=http://localhost:3000
AUTH_SECRET=<random 32-char string>
HOUSEHOLD_PASSWORD_HASH=<bcrypt hash of household password>

ANTHROPIC_API_KEY=<your key>

IMAP_HOST=imap.yourmailhost.com
IMAP_PORT=993
IMAP_USER=recipes@yourdomain.com
IMAP_PASSWORD=<mailbox password>
